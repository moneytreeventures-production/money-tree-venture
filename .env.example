# Safe template only. Values below are examples/placeholders, not credentials.
# Public pages run without provider configuration; server features validate
# their settings when used. Copy to ignored .env.local for local integrations.
# Never commit real secrets or expose server values through NEXT_PUBLIC_ names.

# Application URL is required by Resend transactional email links. NODE_ENV is set by Next.js.
# APP_URL=http://localhost:3000
# Production APP_URL must be the public HTTPS site origin. Scheduled workers
# reject remote HTTP origins before sending their bearer authorization.

# Optional MongoDB integration: both values are required if either is set.
# Use a disposable replica-set database for transaction-capable local testing.
# MONGODB_URI=<MONGODB_URI>
# MONGODB_DB_NAME=moneytreeventures_sandbox
# Integration tests use a separate MONGODB_TEST_URI and generate a disposable
# moneytree_test_* database. Never point it at production.
# MONGODB_TEST_URI=<DISPOSABLE_MONGODB_TEST_URI>
# Optional local-only DNS override for the dev command; use only a network-approved
# resolver IP. The production build/start commands do not load dev-dns.cjs.
# MTV_DEV_DNS_SERVER=<local-resolver-ip>

# Optional Better Auth server configuration: both values are required when
# /api/auth is used. Generate a random secret; do not use this placeholder.
# BETTER_AUTH_URL=http://localhost:3000
# BETTER_AUTH_SECRET=<RANDOM_SECRET>
# Google OAuth is required when enabling sign-in. Configure matching callback
# URLs in Google Cloud Console for each local/staging/production origin.
# GOOGLE_CLIENT_ID=<GOOGLE_CLIENT_ID>
# GOOGLE_CLIENT_SECRET=<GOOGLE_CLIENT_SECRET>
# ADMIN_ALLOWED_EMAILS=moneytreeventuress@gmail.com,developer@example.com
# Server-only exact Google emails. Include the owner explicitly; each account
# also needs an active profile with an explicitly provisioned admin role.

# Optional Cashfree integration: configure the complete group before using
# Hosted Checkout, payment status, webhooks, or refunds. These are sandbox
# placeholders. Use distinct Netlify contexts; never use production values in
# local development or Deploy Previews.
# CASHFREE_ENVIRONMENT=sandbox
# CASHFREE_CLIENT_ID=<CASHFREE_CLIENT_ID>
# CASHFREE_CLIENT_SECRET=<CASHFREE_CLIENT_SECRET>
# CASHFREE_API_VERSION=2026-01-01
# Configure the matching webhook version in the Cashfree dashboard.
# CASHFREE_WEBHOOK_VERSION=2026-01-01
# CASHFREE_RETURN_URL_BASE=http://localhost:3000/checkout/return

# Optional Cloudflare R2 integration: configure the complete group before an
# R2 operation is requested. The bucket must remain private; credentials are
# server-side only. No public URL is required.
# R2_ACCOUNT_ID=replace-with-cloudflare-account-id
# R2_ENDPOINT=https://replace-with-cloudflare-account-id.r2.cloudflarestorage.com
# R2_REGION=auto
# R2_ACCESS_KEY_ID=replace-with-r2-access-key-id
# R2_SECRET_ACCESS_KEY=replace-with-r2-secret-access-key
# R2_BUCKET_NAME=replace-with-private-sandbox-bucket
# R2_MAX_UPLOAD_BYTES=26214400

# Optional public product-media integration. Create separate private staging
# and public-media buckets, plus an access key scoped only to those two buckets.
# The public bucket's custom domain must point only to product media; never point
# this domain at the private PDF bucket. In production use a custom HTTPS domain.
# Local/non-production may use the bucket's r2.dev URL after enabling it manually.
# R2_PUBLIC_MEDIA_ACCESS_KEY_ID=replace-with-media-only-access-key
# R2_PUBLIC_MEDIA_SECRET_ACCESS_KEY=replace-with-media-only-secret
# R2_PUBLIC_MEDIA_STAGING_BUCKET_NAME=replace-with-private-media-staging-bucket
# R2_PUBLIC_MEDIA_BUCKET_NAME=replace-with-public-product-media-bucket
# PUBLIC_MEDIA_BASE_URL=https://media.example.invalid
# PUBLIC_MEDIA_UPLOAD_URL_TTL_SECONDS=300
# R2_PUBLIC_MEDIA_MAX_IMAGE_BYTES=8388608
# R2_PUBLIC_MEDIA_MAX_VIDEO_BYTES=52428800

# Optional Resend integration for transactional outbox email: API key and sender
# require each other and APP_URL. APP_URL can be configured without enabling email.
# Verify sender domain before sending. SUPPORT_EMAIL may be set independently.
# RESEND_API_KEY=re_placeholder_only
# EMAIL_FROM="MoneyTreeVentures <noreply@example.invalid>"
# EMAIL_TESTING_ENABLED=false
# EMAIL_TEST_RECIPIENTS=approved-owner@example.invalid
# EMAIL_TEST_DATABASE_NAME=moneytreeventures
# EMAIL_TEST_DATABASE_ROLE=local-development-only
# EMAIL_LOCAL_WORKER_ENABLED=false
# For an approved HTTPS staging deployment, use staging-only instead.
# EMAIL_TEST_DATABASE_ROLE=staging-only
# SUPPORT_EMAIL=support@example.invalid

# Optional active PDF-download and transactional-outbox settings.
# DOWNLOAD_URL_TTL_SECONDS=60
# Set only after the tax treatment is approved. Integer basis points; do not
# use an example rate for a live catalogue.
# OUTBOX_WORKER_SECRET=replace-with-a-random-worker-secret
# The Netlify order-expiration schedule is disabled unless enabled explicitly.
# ORDER_EXPIRATION_ENABLED=false
# PAYMENT_RECONCILIATION_ENABLED=false
# ORDER_MAINTENANCE_DATABASE=moneytreeventures_sandbox




# APP_URL=https://staging.moneytreeventure.com
# PUBLIC_MEDIA_BASE_URL=https://media.moneytreeventure.com
# MONGODB_URI=<MONGODB_URI>
# MONGODB_DB_NAME=moneytreeventures_staging
# BETTER_AUTH_URL=https://staging.moneytreeventure.com
# BETTER_AUTH_SECRET=<RANDOM_SECRET>
# GOOGLE_CLIENT_ID=<GOOGLE_CLIENT_ID>
# GOOGLE_CLIENT_SECRET=<GOOGLE_CLIENT_SECRET>
# ADMIN_ALLOWED_EMAILS=moneytreeventuress@gmail.com,developer@example.com

# CASHFREE_API_VERSION=2026-01-01
# CASHFREE_WEBHOOK_VERSION=2023-08-01
# CASHFREE_ENVIRONMENT=sandbox
# CASHFREE_CLIENT_ID=<CASHFREE_CLIENT_ID>
# CASHFREE_CLIENT_SECRET=<CASHFREE_CLIENT_SECRET>
# CASHFREE_RETURN_URL_BASE=https://staging.moneytreeventure.com/checkout/return

# R2_ACCOUNT_ID=<CLOUDFLARE_ACCOUNT_ID>
# R2_ENDPOINT=<CLOUDFLARE_R2_S3_ENDPOINT>
# R2_REGION=auto
# R2_ACCESS_KEY_ID=<STAGING_PRIVATE_R2_ACCESS_KEY>
# R2_SECRET_ACCESS_KEY=<STAGING_PRIVATE_R2_SECRET>
# R2_BUCKET_NAME=<PRIVATE_STAGING_PDF_BUCKET>
# R2_MAX_UPLOAD_BYTES=26214400

# R2_PUBLIC_MEDIA_ACCESS_KEY_ID=<STAGING_MEDIA_ACCESS_KEY>
# R2_PUBLIC_MEDIA_SECRET_ACCESS_KEY=<STAGING_MEDIA_SECRET>
# R2_PUBLIC_MEDIA_STAGING_BUCKET_NAME=<PRIVATE_STAGING_UPLOAD_BUCKET>
# R2_PUBLIC_MEDIA_BUCKET_NAME=<STAGING_PUBLIC_MEDIA_BUCKET>
# PUBLIC_MEDIA_UPLOAD_URL_TTL_SECONDS=300
# R2_PUBLIC_MEDIA_MAX_IMAGE_BYTES=8388608
# R2_PUBLIC_MEDIA_MAX_VIDEO_BYTES=52428800

# DOWNLOAD_URL_TTL_SECONDS=60

# SUPPORT_EMAIL=help@moneytreeventure.com

# ORDER_EXPIRATION_ENABLED=false
# PAYMENT_RECONCILIATION_ENABLED=false
