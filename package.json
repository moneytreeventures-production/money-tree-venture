{
  "name": "moneytreeventure",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--require=./dev-dns.cjs next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "node scripts/run-tests.mjs",
    "test:smoke": "node scripts/smoke-production.mjs",
    "test:browser": "node --test tests/browser/*.browser.test.mjs",
    "test:client-secrets": "node scripts/verify-client-secret-bundle.mjs",
    "test:env": "tsc -p tsconfig.env-test.json && node --conditions=react-server --test .test-build/tests/env/env.test.js",
    "test:db": "tsc -p tsconfig.env-test.json && node --conditions=react-server --test .test-build/tests/db/mongodb.test.js",
    "test:integration": "tsc -p tsconfig.env-test.json && node --conditions=react-server --test .test-build/tests/integration/refund-lifecycle.test.js",
    "test:models": "tsc -p tsconfig.env-test.json && node --conditions=react-server --test .test-build/tests/db/models.test.js",
    "test:infra": "tsc -p tsconfig.env-test.json && node --conditions=react-server --test .test-build/tests/errors/errors.test.js .test-build/tests/http/request-id.test.js .test-build/tests/http/request-body.test.js .test-build/tests/logger/logger.test.js",
    "test:providers": "tsc -p tsconfig.env-test.json && node --conditions=react-server --test .test-build/tests/storage/r2.test.js .test-build/tests/storage/public-media.test.js .test-build/tests/payments/cashfree.test.js .test-build/tests/payments/cashfree-webhook.test.js .test-build/tests/payments/cashfree-api.test.js .test-build/tests/payments/refund-api.test.js",
    "test:auth": "tsc -p tsconfig.env-test.json && node --conditions=react-server --test .test-build/tests/auth/auth.test.js .test-build/tests/auth/identity.test.js",
    "test:admin": "tsc -p tsconfig.env-test.json && node --conditions=react-server --test .test-build/tests/auth/admin.test.js .test-build/tests/auth/admin-bootstrap.test.js .test-build/tests/auth/account-navigation.test.js",
    "test:seed": "tsc -p tsconfig.env-test.json && node --conditions=react-server --test .test-build/tests/seed/product-seed-plan.test.js",
    "test:catalog": "tsc -p tsconfig.env-test.json && node --conditions=react-server --test .test-build/tests/catalog/category-validation.test.js .test-build/tests/catalog/category-policy.test.js .test-build/tests/catalog/category-service.test.js .test-build/tests/catalog/category-selection.test.js .test-build/tests/catalog/catalogue-query.test.js .test-build/tests/catalog/product-validation.test.js .test-build/tests/catalog/product-policy.test.js .test-build/tests/catalog/product-service.test.js .test-build/tests/catalog/product-api.test.js .test-build/tests/catalog/product-media.test.js",
    "test:currency": "tsc -p tsconfig.env-test.json && node --conditions=react-server --test .test-build/tests/format/currency.test.js",
    "test:checkout": "tsc -p tsconfig.env-test.json && node --conditions=react-server --test .test-build/tests/cart/cart.test.js .test-build/tests/coupons/preview-pricing.test.js .test-build/tests/checkout/order-rules.test.js .test-build/tests/checkout/pricing.test.js .test-build/tests/checkout/order-api.test.js .test-build/tests/checkout/client-idempotency.test.js",
    "test:fulfillment": "tsc -p tsconfig.env-test.json && node --conditions=react-server --test .test-build/tests/fulfillment/pdf-personalization.test.js .test-build/tests/fulfillment/booking.test.js .test-build/tests/fulfillment/purchase-api.test.js .test-build/tests/email/outbox.test.js && node --test tests/email/netlify-function.test.mjs",
    "admin:bootstrap": "tsc -p tsconfig.admin-cli.json && node --require=./dev-dns.cjs --conditions=react-server .admin-build/scripts/bootstrap-admin.js",
    "admin:revoke": "tsc -p tsconfig.admin-cli.json && node --require=./dev-dns.cjs --conditions=react-server .admin-build/scripts/revoke-admin.js",
    "seed:products": "tsc -p tsconfig.admin-cli.json && node --require=./dev-dns.cjs --conditions=react-server .admin-build/scripts/seed/products.js",
    "db:indexes": "tsc -p tsconfig.admin-cli.json && node --require=./dev-dns.cjs --conditions=react-server .admin-build/scripts/initialize-indexes.js",
    "email:test:resend": "tsc -p tsconfig.admin-cli.json && node --require=./dev-dns.cjs --conditions=react-server .admin-build/scripts/email-test-resend.js",
    "email:worker:local": "node --require=./dev-dns.cjs scripts/local-outbox-worker.mjs",
    "db:inspect": "tsc -p tsconfig.admin-cli.json && node --require=./dev-dns.cjs --conditions=react-server .admin-build/scripts/initialize-indexes.js --inspect",
    "db:bootstrap": "tsc -p tsconfig.admin-cli.json && node --require=./dev-dns.cjs --conditions=react-server .admin-build/scripts/initialize-indexes.js --bootstrap",
    "db:inventory": "tsc -p tsconfig.admin-cli.json && node --require=./dev-dns.cjs --conditions=react-server .admin-build/scripts/initialize-indexes.js --inventory",
    "db:verify": "tsc -p tsconfig.admin-cli.json && node --require=./dev-dns.cjs --conditions=react-server .admin-build/scripts/initialize-indexes.js --verify",
    "db:init": "tsc -p tsconfig.admin-cli.json && node --require=./dev-dns.cjs --conditions=react-server .admin-build/scripts/initialize-indexes.js --init",
    "orders:maintain": "tsc -p tsconfig.admin-cli.json && node --require=./dev-dns.cjs --conditions=react-server .admin-build/scripts/maintain-orders.js",
    "payments:diagnose": "tsc -p tsconfig.admin-cli.json && node --require=./dev-dns.cjs --conditions=react-server .admin-build/scripts/diagnose-payment-recovery.js",
    "payments:recover-expired": "tsc -p tsconfig.admin-cli.json && node --require=./dev-dns.cjs --conditions=react-server .admin-build/scripts/recover-expired-payment.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1170.0",
    "@aws-sdk/s3-request-presigner": "^3.1170.0",
    "@better-auth/mongo-adapter": "^1.7.25",
    "@tailwindcss/turbopack": "4.3.3",
    "better-auth": "^1.7.25",
    "lucide-react": "^1.73.0",
    "mongoose": "^9.12.2",
    "motion": "^14.14.0",
    "next": "16.4.6",
    "next-themes": "^0.4.6",
    "pdf-lib": "^1.17.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cross-env": "^10.1.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "typescript": "^5"
  }
}
