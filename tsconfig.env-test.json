{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node",
    "noEmit": false,
    "noEmitOnError": true,
    "incremental": false,
    "outDir": ".test-build",
    "rootDir": "."
  },
  "include": [
    "src/lib/catalog/**/*.ts",
    "src/instrumentation.ts",
    "src/lib/env/server.ts",
    "src/lib/env/schema.ts",
    "src/lib/auth/**/*.ts",
    "src/app/api/navigation/**/*.ts",
    "src/app/api/preferences/**/*.ts",
    "scripts/bootstrap-admin.ts",
    "scripts/initialize-indexes.ts",
    "scripts/seed/product-seed-plan.ts",
    "scripts/seed/source-products.ts",
    "src/lib/db/connection-manager.ts",
    "src/lib/db/mongodb.ts",
    "src/lib/db/models/**/*.ts",
    "src/lib/errors/**/*.ts",
    "src/lib/http/**/*.ts",
    "src/lib/http/response.ts",
    "src/lib/logger/**/*.ts",
    "src/lib/storage/**/*.ts",
    "src/lib/payments/cashfree/**/*.ts",
    "src/app/api/auth/[...all]/route.ts",
    "src/app/api/admin/orders/**/*.ts",
    "tests/env/env.test.ts",
    "tests/db/mongodb.test.ts",
    "tests/integration/**/*.ts",
    "tests/db/models.test.ts",
    "tests/db/index-initialization.test.ts",
    "tests/db/production-index-migration.test.ts",
    "tests/errors/errors.test.ts",
    "tests/http/**/*.test.ts",
    "tests/logger/logger.test.ts",
    "tests/storage/r2.test.ts",
    "tests/storage/public-media.test.ts",
    "tests/payments/cashfree.test.ts",
    "tests/payments/result-presentation.test.ts",
    "tests/payments/cashfree-webhook.test.ts",
    "tests/payments/cashfree-api.test.ts",
    "tests/payments/payment-recovery.test.ts",
    "tests/payments/status-polling.test.ts",
    "tests/payments/expired-failure-recovery.test.ts",
    "tests/payments/refund-api.test.ts",
    "tests/auth/auth.test.ts",
    "tests/auth/identity.test.ts",
    "tests/auth/admin.test.ts",
    "tests/auth/admin-bootstrap.test.ts",
    "tests/auth/account-navigation.test.ts",
    "tests/seed/**/*.ts",
    "tests/catalog/**/*.ts"
    ,"src/lib/cart/**/*.ts",
    "src/lib/checkout/**/*.ts",
    "src/lib/fulfillment/**/*.ts",
    "src/lib/email/**/*.ts",
    "tests/cart/**/*.ts",
    "tests/checkout/**/*.ts",
    "tests/fulfillment/**/*.ts",
    "tests/email/**/*.ts"
    ,"tests/format/**/*.ts",
    "tests/reviews.test.ts",
    "tests/support.test.ts",
    "tests/coupons.test.ts",
    "tests/coupons/**/*.ts"
  ],
  "exclude": ["node_modules"]
}

